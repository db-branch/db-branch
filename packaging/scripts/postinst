#!/bin/sh
set -e

if ! getent group db-branch >/dev/null; then
	addgroup --system db-branch
fi
if ! getent passwd db-branch >/dev/null; then
	adduser --system --ingroup db-branch --home /var/lib/db-branch --no-create-home \
		--shell /usr/sbin/nologin --gecos "db-branch" db-branch
fi
# The agent's socket and its configuration belong to db-branch-admin, not to the
# group the database servers run in. People who could use db-branch through that
# group keep doing so.
if ! getent group db-branch-admin >/dev/null; then
	addgroup --system db-branch-admin
	for m in $(getent group db-branch | cut -d: -f4 | tr ',' ' '); do
		[ "$m" = db-branch ] && continue
		adduser "$m" db-branch-admin >/dev/null 2>&1 || true
	done
fi
chgrp db-branch-admin /etc/db-branch/config.toml

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	systemctl enable db-branch.service >/dev/null
	systemctl restart db-branch.service
fi
