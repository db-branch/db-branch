#!/bin/sh
set -e

# Branch data lives on ZFS and in /var/lib/db-branch, and is never removed by
# the package.
case "$1" in
remove)
	if [ -z "${DPKG_ROOT:-}" ] && [ -d "${DB_BRANCH_PKG_ROOT:-}/run/systemd/system" ]; then
		systemctl daemon-reload || true
	fi
	;;
purge)
	if [ -z "${DPKG_ROOT:-}" ] && [ -d "${DB_BRANCH_PKG_ROOT:-}/run/systemd/system" ]; then
		systemctl disable db-branch.service >/dev/null 2>&1 || true
		systemctl daemon-reload || true
	fi
	rm -f "${DB_BRANCH_PKG_ROOT:-}/etc/systemd/system/multi-user.target.wants/db-branch.service"
	rm -rf "${DB_BRANCH_PKG_ROOT:-}/etc/db-branch"
	rm -f "${DB_BRANCH_PKG_ROOT:-}/etc/modprobe.d/db-branch-zfs.conf"
	;;
upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
*)
	echo "postrm called with unknown argument '$1'" >&2
	exit 1
	;;
esac
